# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend / App CORS Configuration
CORS_ORIGIN=*

# Neon PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://username:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/smartshetkari?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/smartshetkari_db?sslmode=require"

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_smartshetkari_2026_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
