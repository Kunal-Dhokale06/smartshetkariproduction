// Scalable Production-Grade Prisma Schema for SmartShetkari
// Database: Neon Serverless PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum CropSeason {
  KHARIF
  RABI
  ZAID
  YEAR_ROUND
}

enum CropStatus {
  GROWING
  HARVESTED
  FAILED
  PLANNED
}

enum ExpenseCategory {
  FERTILIZER
  SEEDS
  PESTICIDE
  LABOR
  IRRIGATION
  MACHINERY
  TRANSPORT
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  CREDIT
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

enum NoteSource {
  TEXT
  VOICE
}

enum BillStatus {
  PENDING
  PROCESSED
  VERIFIED
}

enum NotificationType {
  WEATHER
  MARKET_RATE
  EXPENSE_ALERT
  DIARY_REMINDER
  CROP_ADVISORY
  SYSTEM
}

enum MessageSender {
  USER
  ASSISTANT
  SYSTEM
}

// -----------------------------------------------------------------------------
// USER / FARMER MODEL
// -----------------------------------------------------------------------------

model User {
  id              String            @id @default(uuid()) @db.Uuid
  phone           String            @unique
  password        String            // Hashed using bcrypt
  name            String
  email           String?           @unique
  avatarUrl       String?
  village         String?
  taluka          String?
  district        String?
  state           String            @default("Maharashtra")
  landArea        Decimal?          @db.Decimal(10, 2)
  landAreaUnit    String            @default("Acre")
  language        String            @default("mr") // 'en' | 'mr' | 'hi'
  isVerified      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  crops           Crop[]
  expenses        Expense[]
  sales           Sale[]
  diaryEntries    DiaryEntry[]
  bills           Bill[]
  budgets         Budget[]
  notifications   Notification[]
  aiConversations AIConversation[]

  @@index([phone])
  @@index([district, state])
  @@map("users")
}

// -----------------------------------------------------------------------------
// CROP MODEL
// -----------------------------------------------------------------------------

model Crop {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.Uuid
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name                String       // e.g. Wheat, Cotton, Sugarcane, Tomato, Soybean
  variety             String?      // e.g. Lokwan, Bt Cotton, CO 86032
  sowingDate          DateTime
  expectedHarvestDate DateTime?
  actualHarvestDate   DateTime?
  area                Decimal      @db.Decimal(10, 2)
  areaUnit            String       @default("Acre")
  season              CropSeason   @default(KHARIF)
  status              CropStatus   @default(GROWING)
  iconName            String       @default("sprout")
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  expenses            Expense[]
  sales               Sale[]
  diaryEntries        DiaryEntry[]
  budgets             Budget[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, season])
  @@index([name])
  @@map("crops")
}

// -----------------------------------------------------------------------------
// EXPENSE MODEL
// -----------------------------------------------------------------------------

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cropId      String?         @db.Uuid
  crop        Crop?           @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropName    String          // Cached crop name for historical reporting even if crop is deleted
  
  billId      String?         @db.Uuid
  bill        Bill?           @relation(fields: [billId], references: [id], onDelete: SetNull)
  
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  paymentMode PaymentMode     @default(CASH)
  date        DateTime
  vendorName  String?
  receiptUrl  String?
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
  @@index([userId, cropId])
  @@index([cropId])
  @@map("expenses")
}

// -----------------------------------------------------------------------------
// SALE MODEL
// -----------------------------------------------------------------------------

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cropId        String?       @db.Uuid
  crop          Crop?         @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropName      String        // e.g. Wheat, Cotton
  
  quantity      Decimal       @db.Decimal(10, 2)
  unit          String        @default("Quintal") // Kg, Quintal, Ton, Bag, Crate
  pricePerUnit  Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  
  marketName    String        // e.g. Pune APMC Market, Baramati Mandi
  buyerName     String?
  paymentStatus PaymentStatus @default(PAID)
  date          DateTime
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, cropId])
  @@index([cropId])
  @@index([marketName])
  @@map("sales")
}

// -----------------------------------------------------------------------------
// DIARY ENTRY MODEL
// -----------------------------------------------------------------------------

model DiaryEntry {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cropId    String?     @db.Uuid
  crop      Crop?       @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropName  String
  
  title     String?
  content   String      @db.Text
  date      DateTime
  source    NoteSource  @default(TEXT)
  audioUrl  String?
  tags      String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, cropId])
  @@map("diary_entries")
}

// -----------------------------------------------------------------------------
// BILL / RECEIPT OCR MODEL
// -----------------------------------------------------------------------------

model Bill {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  invoiceNumber String?
  vendorName    String
  vendorPhone   String?
  vendorAddress String?
  totalAmount   Decimal     @db.Decimal(12, 2)
  billDate      DateTime
  imageUrl      String?
  rawOcrText    String?     @db.Text
  status        BillStatus  @default(VERIFIED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  expenses      Expense[]

  @@index([userId])
  @@index([userId, billDate])
  @@map("bills")
}

// -----------------------------------------------------------------------------
// SEASONAL BUDGET MODEL
// -----------------------------------------------------------------------------

model Budget {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cropId          String?     @db.Uuid
  crop            Crop?       @relation(fields: [cropId], references: [id], onDelete: SetNull)
  
  season          CropSeason  @default(KHARIF)
  year            Int
  totalBudget     Decimal     @db.Decimal(12, 2)
  
  fertilizerAlloc Decimal     @default(0) @db.Decimal(12, 2)
  seedsAlloc      Decimal     @default(0) @db.Decimal(12, 2)
  pesticideAlloc  Decimal     @default(0) @db.Decimal(12, 2)
  laborAlloc      Decimal     @default(0) @db.Decimal(12, 2)
  machineryAlloc  Decimal     @default(0) @db.Decimal(12, 2)
  irrigationAlloc Decimal     @default(0) @db.Decimal(12, 2)
  otherAlloc      Decimal     @default(0) @db.Decimal(12, 2)
  
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, year, season, cropId])
  @@index([userId])
  @@index([userId, year])
  @@map("budgets")
}

// -----------------------------------------------------------------------------
// NOTIFICATION MODEL
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// AI ADVISORY CONVERSATION & MESSAGE MODELS
// -----------------------------------------------------------------------------

model AIConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String      @default("Smart Advisory Chat")
  language  String      @default("mr")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  AIMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  sender         MessageSender  @default(USER)
  content        String         @db.Text
  intent         String?        // e.g. crop_disease, mandi_rate, fertilizer_dose, weather_plan
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// -----------------------------------------------------------------------------
// LOCATION MASTER DATA (MAHARASHTRA LGD DATASET)
// -----------------------------------------------------------------------------

model District {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // Official LGD District Code
  nameEn    String
  nameMr    String
  nameHi    String?
  stateCode String   @default("MH")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  talukas   Taluka[]

  @@index([stateCode])
  @@index([nameEn])
  @@index([nameMr])
  @@map("districts")
}

model Taluka {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique // Official LGD Sub-District / Taluka Code
  districtId String   @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  
  nameEn     String
  nameMr     String
  nameHi     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  villages   Village[]

  @@index([districtId])
  @@index([nameEn])
  @@index([nameMr])
  @@map("talukas")
}

model Village {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // Official LGD Village Code
  talukaId  String   @db.Uuid
  taluka    Taluka   @relation(fields: [talukaId], references: [id], onDelete: Cascade)
  
  nameEn    String
  nameMr    String
  nameHi    String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([talukaId])
  @@index([nameEn])
  @@index([nameMr])
  @@map("villages")
}

